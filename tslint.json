{
  "extends": "tslint:recommended",
  "rulesDirectory": [
    "codelyzer"
  ],
  "linterOptions": {
    "exclude": [
      "src/app/legacy/**",
      "src/polyfills.ts",
      "src/test.ts"
    ]
  },
  "rules": {
    "align": {
      "options": [
        "parameters",
        "statements"
      ]
    },
    "array-type": false,
    "arrow-parens": false,
    "arrow-return-shorthand": true,
    "curly": true,
    "deprecation": {
      "severity": "warning"
    },
    "eofline": true,
    "import-blacklist": [
      true,
      "rxjs/Rx",
      "rxjs/internal/operators",
      "lodash-es"
    ],
    "import-spacing": true,
    "indent": {
      "options": [
        "spaces"
      ]
    },
    "interface-name": false,
    "max-classes-per-file": false,
    "max-line-length": [
      true,
      {
        "limit": 220,
        "_comment": "MBZ-1893 raised from 140 after the 2021 prettier sweep left the reducers and wizard components over the line; nobody has gone back to re-wrap them",
        "ignore-pattern": "^import |^export {(.*?)}"
      }
    ],
    "member-access": false,
    "member-ordering": [
      true,
      {
        "order": [
          "static-field",
          "instance-field",
          "static-method",
          "instance-method"
        ]
      }
    ],
    "no-console": [
      true,
      "debug",
      "info",
      "time",
      "timeEnd",
      "trace"
    ],
    "no-empty": false,
    "no-inferrable-types": [
      true,
      "ignore-params"
    ],
    "no-non-null-assertion": true,
    "no-redundant-jsdoc": true,
    "no-switch-case-fall-through": true,
    "no-var-requires": false,
    "object-literal-key-quotes": [
      true,
      "as-needed"
    ],
    "object-literal-sort-keys": false,
    "ordered-imports": false,
    "quotemark": [
      true,
      "single"
    ],
    "semicolon": {
      "options": [
        "always"
      ]
    },
    "space-before-function-paren": {
      "options": {
        "anonymous": "never",
        "asyncArrow": "always",
        "constructor": "never",
        "method": "never",
        "named": "never"
      }
    },
    "trailing-comma": false,
    "typedef": [
      true,
      "call-signature"
    ],
    "typedef-whitespace": {
      "options": [
        {
          "call-signature": "nospace",
          "index-signature": "nospace",
          "parameter": "nospace",
          "property-declaration": "nospace",
          "variable-declaration": "nospace"
        },
        {
          "call-signature": "onespace",
          "index-signature": "onespace",
          "parameter": "onespace",
          "property-declaration": "onespace",
          "variable-declaration": "onespace"
        }
      ]
    },
    "variable-name": {
      "options": [
        "ban-keywords",
        "check-format",
        "allow-pascal-case",
        "allow-leading-underscore"
      ]
    },
    "whitespace": {
      "options": [
        "check-branch",
        "check-decl",
        "check-operator",
        "check-separator",
        "check-type",
        "check-typecast"
      ]
    },

    "ban": [
      true,
      {
        "name": ["console", "log"],
        "message": "GIS-STD-014 s9: no console logging in a channel application. Use TelemetryService."
      },
      {
        "name": ["*", "bypassSecurityTrustHtml"],
        "message": "GIS-STD-014 s4: sanitiser bypass needs a documented GIS exception. Raise with #gis-appsec."
      },
      {
        "name": ["*", "bypassSecurityTrustScript"],
        "message": "GIS-STD-014 s4: sanitiser bypass needs a documented GIS exception."
      },
      {
        "name": ["localStorage", "setItem"],
        "message": "GIS-STD-014 s1: nothing session related goes in localStorage. MBZ-988."
      },
      {
        "name": "eval",
        "message": "Never."
      }
    ],
    "no-any": {
      "severity": "warning"
    },
    "no-implicit-dependencies": false,
    "no-floating-promises": {
      "severity": "warning"
    },
    "prefer-const": true,
    "no-duplicate-imports": true,
    "no-magic-numbers": false,
    "no-string-literal": false,
    "no-unused-expression": true,
    "no-shadowed-variable": {
      "severity": "warning"
    },
    "prefer-for-of": {
      "severity": "warning"
    },
    "unified-signatures": true,

    "component-class-suffix": true,
    "directive-class-suffix": true,
    "component-selector": [
      true,
      "element",
      ["mbz", "app"],
      "kebab-case"
    ],
    "directive-selector": [
      true,
      "attribute",
      ["mbz", "app"],
      "camelCase"
    ],
    "pipe-prefix": [
      true,
      "mbz"
    ],
    "contextual-lifecycle": true,
    "no-conflicting-lifecycle": true,
    "no-host-metadata-property": true,
    "no-input-rename": true,
    "no-inputs-metadata-property": true,
    "no-output-native": true,
    "no-output-on-prefix": true,
    "no-output-rename": true,
    "no-outputs-metadata-property": true,
    "no-attribute-decorator": true,
    "no-forward-ref": false,
    "no-lifecycle-call": true,
    "no-pipe-impure": {
      "severity": "warning"
    },
    "no-queries-metadata-property": true,
    "prefer-inline-decorator": false,
    "prefer-on-push-component-change-detection": false,
    "template-accessibility-alt-text": true,
    "template-accessibility-elements-content": true,
    "template-accessibility-label-for": {
      "severity": "warning"
    },
    "template-accessibility-tabindex-no-positive": true,
    "template-accessibility-table-scope": true,
    "template-accessibility-valid-aria": true,
    "template-banana-in-box": true,
    "template-click-events-have-key-events": {
      "severity": "warning"
    },
    "template-mouse-events-have-key-events": {
      "severity": "warning"
    },
    "template-no-any": {
      "severity": "warning"
    },
    "template-no-autofocus": true,
    "template-no-distracting-elements": true,
    "template-no-negated-async": true,
    "template-use-track-by-function": {
      "severity": "warning"
    },
    "use-component-selector": true,
    "use-component-view-encapsulation": {
      "severity": "warning"
    },
    "use-lifecycle-interface": true,
    "use-pipe-transform-interface": true
  }
}
