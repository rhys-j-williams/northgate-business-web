{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "_comment": "Schema last reviewed against CLI 8.3 when the workspace was created (MBZ-12). The tslint builder entries were removed by hand at the v11 to v12 step because ng lint stopped recognising them; lint now runs from the package script. See docs/adr/0003-keep-tslint.md.",
  "cli": {
    "packageManager": "npm",
    "analytics": false,
    "defaultCollection": "@schematics/angular"
  },
  "newProjectRoot": "projects",
  "projects": {
    "meridian-business": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "mbz",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/meridian-business",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "canopy-sprite.svg",
                "input": "node_modules/@meridian/canopy-ui/icons",
                "output": "/assets/canopy"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/styles",
                "node_modules"
              ]
            },
            "scripts": [],
            "allowedCommonJsDependencies": [
              "moment",
              "lodash"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3mb",
                  "maximumError": "6mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kb",
                  "maximumError": "16kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true
            },
            "mock-external": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.mock.ts"
                }
              ],
              "aot": false,
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "development": {
              "aot": false,
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "port": 4201,
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "browserTarget": "meridian-business:build:production"
            },
            "mock-external": {
              "browserTarget": "meridian-business:build:mock-external"
            },
            "development": {
              "browserTarget": "meridian-business:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "canopy-sprite.svg",
                "input": "node_modules/@meridian/canopy-ui/icons",
                "output": "/assets/canopy"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/styles",
                "node_modules"
              ]
            },
            "scripts": [],
            "codeCoverageExclude": [
              "src/app/legacy/testing/**",
              "src/app/core/services/fixture-data.service.ts",
              "src/environments/**"
            ]
          }
        }
      }
    }
  },
  "defaultProject": "meridian-business"
}
