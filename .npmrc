# Northgate Business registry configuration. Reviewed under DEPENDENCY_POLICY.md (GIS-1180).
#
# Local: the estate's Verdaccio on 4873 (mock-external/estate-up.sh). On the nodejs16-rhel8 agents
# the Vault agent renders the Artifactory token into ~/.npmrc, so this file does not change per run.
@northgate:registry=http://localhost:4873
# @northgate:registry=https://artifactory.northgate.internal/artifactory/api/npm/npm-northgate-virtual/

# MBZ-1877: a contractor ran the build on a different Node major and produced a lockfile nobody
# could install. engine-strict makes npm refuse instead of warn; the pin is Node 16.20.2 / npm 8
# since MBZ-2140 (MBZ-2231). Do not remove without talking to #business-digital.
engine-strict=true
save-exact=true

# legacy-peer-deps=true was here from MBZ-2044 (Canopy 3.x rxjs ^7 peer against rxjs 6.6.7). Dropped in
# MBZ-2140 once the app moved to rxjs 7.5.7: the tree resolves without it (see
# docs/upgrade/MBZ-2140/14-to-15/A2-rxjs7/legacy-peer-deps-check.log).

# CHROME_BIN comes from the agent image; nothing here downloads a browser.
fund=false
audit=false
