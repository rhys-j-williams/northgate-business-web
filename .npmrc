# Meridian Business registry configuration. Reviewed under DEPENDENCY_POLICY.md (GIS-1180).
#
# Local: the estate's Verdaccio on 4873 (mock-external/estate-up.sh). On the nodejs14-rhel7 agents
# the Vault agent renders the Artifactory token into ~/.npmrc, so this file does not change per run.
@meridian:registry=http://localhost:4873
# @meridian:registry=https://artifactory.meridian.internal/artifactory/api/npm/npm-meridian-virtual/

# MBZ-1877: a contractor ran the build on Node 16 and produced a lockfile nobody could install.
# engine-strict makes npm refuse instead of warn. Do not remove without talking to #business-digital.
engine-strict=true
save-exact=true

# Canopy 3.x declares an rxjs ^7 peer and we are still on 6.6.7 (MBZ-2044, parked). npm 6 only
# warns about peers, but the flag is here so that anyone who tries npm 7+ locally gets the same tree.
legacy-peer-deps=true

# CHROME_BIN comes from the agent image; nothing here downloads a browser.
fund=false
audit=false
