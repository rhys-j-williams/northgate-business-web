{
  "name": "northgate-business",
  "version": "2026.09.0",
  "description": "Northgate Business. Small business online banking front end.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "16.20.2",
    "npm": "8.19.4"
  },
