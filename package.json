    "node-releases": "2.0.44"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4201",
    "start:mock-external": "ng serve --port 4201 --configuration mock-external",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "test:watch": "ng test",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "audit:report": "npm audit --json > .xray/npm-audit.json || true"
  },
